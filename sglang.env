# ============================================================
# sglang server configuration — used by `make sglang-up`.
# This is the configuration that actually works on the current
# GPU host (provider GPU-sharing shim). See LEARNINGS.md for why.
# ============================================================

# Container + image
SGLANG_CONTAINER=sglang-qwen36-27b
SGLANG_IMAGE=lmsysorg/sglang:latest
# Docker volume holding the HuggingFace cache (shared with the vLLM stack)
HF_CACHE_VOLUME=llm-serve-nvidia_hf-cache

# --- Model --------------------------------------------------
MODEL=Qwen/Qwen3.6-27B-FP8
TP_SIZE=1

# --- Server -------------------------------------------------
PORT=8000

# --- Memory (see LEARNINGS.md for the calculation) ----------
# 0.75 keeps weights (28.5 GiB) + KV inside real free VRAM and
# limits the pod-RAM pressure that killed higher settings.
MEM_FRACTION_STATIC=0.75
CONTEXT_LENGTH=32768
# fp8 KV halves cache memory (~66K cache tokens)
KV_CACHE_DTYPE=fp8_e4m3
# bfloat16 halves Mamba state size -> raises concurrent-request cap
MAMBA_SSM_DTYPE=bfloat16

# --- Parsers (Qwen3.6 thinking + tool calling) --------------
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen

# --- Reliability --------------------------------------------
# Self-heal: if a forward pass wedges > this many seconds, sglang
# aborts and Docker's restart policy relaunches it.
WATCHDOG_TIMEOUT=600

# --- Host GPU-sharing shim ----------------------------------
# REQUIRED on this host: full transparent mode. Disables the shim's
# scheduler lock, memswap, and UVM interposition, all of which broke
# both vLLM and sglang (JIT kernel init, CUDA IPC, graph capture).
# NOTE: single-tenant only — see LEARNINGS.md caveats.
# Set empty on hosts without the shim.
HAISHARE_PASSTHROUGH=

# Any extra `sglang.launch_server` flags, passed through verbatim
SGLANG_EXTRA_ARGS=
