# ============================================================
# sglang server configuration — edit and `make restart` to apply.
# Tuned for: RadixArk/Qwen3.8-27B-NVFP4 on a single 48 GB NVIDIA
# L40S behind the cloud provider's GPU-sharing shim.
# Measured with this config: ~70 tok/s per stream, ~366 tok/s
# aggregate at 5 concurrent users. See LEARNINGS.md for the story.
# Empty values fall back to sglang's own defaults.
# ============================================================

# --- Model --------------------------------------------------
# NVFP4 (~15.5 GB) halves per-token bandwidth cost vs FP8 (28.5 GB),
# nearly doubling the decode ceiling on this card.
MODEL=RadixArk/Qwen3.8-27B-NVFP4
# Name exposed by the API (defaults to MODEL if empty)
SERVED_MODEL_NAME=
# Community checkpoint — requires trusting its code
TRUST_REMOTE_CODE=true

# --- Server -------------------------------------------------
HOST=0.0.0.0
PORT=8000
# If set, clients must send "Authorization: Bearer <API_KEY>"
API_KEY=

# --- Memory / capacity --------------------------------------
TP_SIZE=1
# 0.88 is the sweet spot: 0.90 starves CUDA graph capture (crashes),
# 0.85 wastes KV capacity. Yields a ~550K-token fp8 KV pool.
MEM_FRACTION_STATIC=0.88
# 262144 = the model's native max (RoPE-scaling past it hurts quality).
# Costs no extra VRAM — the pool is sized by MEM_FRACTION_STATIC; this
# only caps per-request length. Tradeoffs at max: one 256K request eats
# ~8.5 GB of the ~18 GB KV pool (2 maxed requests fill it), and a 256K
# prompt's prefill takes minutes on this card. Drop to 131072 if long
# requests start starving concurrent users.
CONTEXT_LENGTH=262144
# Was 1 in the cookbook — serialized all users into a queue!
MAX_RUNNING_REQUESTS=8
# fp8 KV halves cache memory
KV_CACHE_DTYPE=fp8_e4m3

# --- Throughput ---------------------------------------------
CHUNKED_PREFILL_SIZE=8192
# Prefill chunks share batches with decode: long prompts don't stall streams
ENABLE_MIXED_CHUNK=true
# Batches scheduler iterations (less per-token CPU overhead)
NUM_CONTINUOUS_DECODE_STEPS=2
ATTENTION_BACKEND=flashinfer

# --- CUDA graphs --------------------------------------------
# Decode graphs = the ~2-3x eager-mode recovery. PREFILL capture must
# stay DISABLED: its 58-graph marathon is where the host shim strikes
# (cudaErrorStreamCaptureInvalidated). See LEARNINGS.md.
CUDA_GRAPH_MAX_BS=8
CUDA_GRAPH_BACKEND_PREFILL=disabled
CUDA_GRAPH_BACKEND_DECODE=

# --- Speculative decoding (MTP) -----------------------------
# In-checkpoint MTP head, ~1.3-1.4x measured on prose. steps 5 /
# draft 6 beat the cookbook's 3/4 on our workloads; revert if
# acceptance drops on yours.
SPEC_ALGORITHM=EAGLE
SPEC_NUM_STEPS=5
SPEC_EAGLE_TOPK=1
SPEC_NUM_DRAFT_TOKENS=6

# --- Hybrid (Mamba) state cache -----------------------------
# bfloat16 halves state size -> more concurrent request slots
MAMBA_SSM_DTYPE=bfloat16
MAMBA_FULL_MEMORY_RATIO=2.34
MAMBA_RADIX_CACHE_STRATEGY=extra_buffer

# --- Host GPU-sharing shim workarounds ----------------------
# CUDA IPC handles can't be created on the shim's managed memory;
# cpu transport avoids the crash (VL-capable arch initializes this
# pool even for text serving).
MM_FEATURE_TRANSPORT=cpu

# --- Chat / tool calling ------------------------------------
# Qwen3.8 is a thinking model: reasoning goes to reasoning_content
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder

# --- Reliability --------------------------------------------
# Self-heal: if a forward pass wedges > this many seconds, sglang
# aborts and Docker's restart policy relaunches it.
WATCHDOG_TIMEOUT=600

# --- Infrastructure -----------------------------------------
# sglang base image tag (cu129 runtime: glibc new enough for the
# provider's injected shim — older images hard-crash on GLIBC_2.38)
SGLANG_VERSION=latest-cu129-runtime
# Host path for the HuggingFace cache (the provider's 196G NFS share;
# keeps model downloads off the small root disk)
HF_CACHE_DIR=/data/share73/hf-cache

# Any additional `sglang.launch_server` flags, passed through verbatim.
# NOTE on thinking control: this template has NO effort dial (only the
# enable_thinking on/off toggle). "Low thinking" is achieved client-side
# via a brevity system prompt (see README); hard-off per request with
#   "chat_template_kwargs": {"enable_thinking": false}
EXTRA_ARGS=--default-chat-template-kwargs {"enable_thinking":false}
