# ============================================================
# vLLM server configuration — edit and `make restart` to apply.
# Tuned for: Qwen/Qwen3.6-27B-FP8 on a single 48 GB NVIDIA L40S.
# Empty values fall back to vLLM's own defaults.
# ============================================================

# --- Model --------------------------------------------------
# HuggingFace repo id or a local path mounted into the container.
# Qwen3.6-27B-FP8: ~28 GB of FP8 weights, thinking model, 262K native context.
MODEL=unsloth/Qwen3.6-27B-NVFP4
# Name exposed by the API (defaults to MODEL if empty)
SERVED_MODEL_NAME=
# Pin a specific HF revision/commit (optional)
MODEL_REVISION=

# --- HuggingFace access -------------------------------------
# Only needed for gated models (Llama, Gemma, ...) — Qwen is open
HF_TOKEN=

# --- Server -------------------------------------------------
HOST=0.0.0.0
PORT=8000
# If set, clients must send "Authorization: Bearer <API_KEY>"
API_KEY=

# --- GPU / parallelism --------------------------------------
# "all" or a number of GPUs to expose to the container
GPU_COUNT=1
# Split the model across this many GPUs (usually = number of GPUs)
TENSOR_PARALLEL_SIZE=1
PIPELINE_PARALLEL_SIZE=
# Fraction of VRAM vLLM may use (0.0-1.0). 0.85 keeps the whole model
# + KV cache inside the ~40 GiB the GPU-sharing shim truly leaves free,
# so the shim never needs to evict/swap anything (see HAISHARE_* below).
GPU_MEMORY_UTILIZATION=0.85
# Offload part of the weights to CPU RAM (GiB)
CPU_OFFLOAD_GB=

# --- Context & throughput -----------------------------------
# 65536 fits the smaller KV budget under GPU_MEMORY_UTILIZATION=0.85
# (see shim notes below). Raise to 131072 on a dedicated GPU.
MAX_MODEL_LEN=65536
# Max concurrent sequences per batch
MAX_NUM_SEQS=
MAX_NUM_BATCHED_TOKENS=

# --- Precision / quantization -------------------------------
# auto | half | bfloat16 | float16 | float32
DTYPE=auto
# Leave EMPTY: the checkpoint is pre-quantized FP8 and vLLM
# auto-detects it from the model config.
QUANTIZATION=
# e.g. fp8 to halve KV-cache memory (leave empty for accuracy)
KV_CACHE_DTYPE=

# --- Chat / tool calling ------------------------------------
# Path to a custom chat template (mount it into the container).
# Leave empty: the model ships its own template.
CHAT_TEMPLATE=
# Qwen3.6 uses the qwen3_coder tool-call format
TOOL_CALL_PARSER=qwen3_coder
ENABLE_AUTO_TOOL_CHOICE=true
# Qwen3.6 is a thinking model: this splits <think> blocks into the
# API's reasoning_content field instead of polluting content.
REASONING_PARSER=qwen3

# --- Toggles (true/false) -----------------------------------
# Required by some models (e.g. custom architectures)
TRUST_REMOTE_CODE=false
# Disable CUDA graphs. REQUIRED on this host: the provider's GPU-sharing
# shim (libhaishare memswap) calls cuCtxSynchronize during vLLM's CUDA
# graph capture, invalidating it (cudaErrorStreamCaptureInvalidated).
# Costs some decode throughput; revert to false on hosts without the shim.
ENFORCE_EAGER=true
ENABLE_PREFIX_CACHING=true
DISABLE_LOG_REQUESTS=false

# --- Misc ---------------------------------------------------
TOKENIZER=
SEED=
# --- Host GPU-sharing shim (libhaishare) --------------------
# The provider preloads a GPU-sharing shim (an nvshare fork) into the
# container. It auto-detects vLLM and force-enables "memswap" (VRAM
# eviction), which repeatedly wedged the engine (requests hang forever,
# HAI-9473 lock-gate warnings every 30s). PASSTHROUGH_TEMPORAL is the
# shim's cooperative opt-out: transparent execution, still participates
# in the time-slice scheduler, but NO memswap/per-kernel gating for this
# pod. Remove on hosts without the shim.
HAISHARE_PASSTHROUGH_TEMPORAL=1

# vLLM base image tag. Qwen3.6 requires vLLM >= 0.19.0.
# ubuntu2404 variant: glibc 2.39, needed because the cloud host injects
# a GPU-sharing shim (libhaishare.so) built against glibc >= 2.38.
VLLM_VERSION=v0.19.1-ubuntu2404
# Any additional `vllm serve` flags, passed through verbatim.
# Optional speedup — multi-token prediction (speculative decoding):
# EXTRA_ARGS=--speculative-config {"method":"qwen3_next_mtp","num_speculative_tokens":2}
EXTRA_ARGS=
